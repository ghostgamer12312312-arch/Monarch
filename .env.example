# Never commit your real bot token. Keep it in a local, ignored .env file or host secret store.
BOT_TOKEN=replace_with_your_new_botfather_token
# Optional: comma-separated Telegram user IDs for trusted administrators.
ADMIN_IDS=
# Optional: comma-separated Telegram user IDs for owners (defaults to ADMIN_IDS).
OWNER_IDS=
# Community links shown in the bot menus.
GROUP_LINK=
CHANNEL_LINK=
SUPPORT_LINK=
# Numeric chat ID (or @username) that receives /query reports.
QUERY_GROUP_ID=
DATABASE_PATH=data/monarch.sqlite3
LOG_LEVEL=INFO
